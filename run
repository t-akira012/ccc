#!/bin/bash
set -e

run_container(){
  if [ "${CLAUDE_CODE_USE_BEDROCK:-0}" != 0 ]; then
    mode=bedrock
  else
    mode=normal
  fi

  if [[ -z "$COMPOSE_ARGS" ]]; then
    echo "COMPOSE_ARGS is required. Run this through host.sh/Makefile." >&2
    exit 1
  fi

  if [[ -z "$SERVICE_NAME" ]]; then
    echo "SERVICE_NAME is required. Run this through host.sh/Makefile." >&2
    exit 1
  fi

  case "$mode" in
  normal)
    docker-compose ${COMPOSE_ARGS} exec \
      ${SERVICE_NAME} bash
    ;;
  bedrock)
    local CREDS
    CREDS="$(aws configure export-credentials --profile "${AWS_PROFILE}" --format process)"
    docker-compose ${COMPOSE_ARGS} exec \
      -e AWS_ACCESS_KEY_ID="$(jq -r .AccessKeyId <<<"${CREDS}")" \
      -e AWS_SECRET_ACCESS_KEY="$(jq -r .SecretAccessKey <<<"${CREDS}")" \
      -e AWS_SESSION_TOKEN="$(jq -r .SessionToken <<<"${CREDS}")" \
      -e AWS_REGION=ap-northeast-1 \
      -e CLAUDE_CODE_USE_BEDROCK \
      -e ANTHROPIC_MODEL \
      ${SERVICE_NAME} bash
    ;;
  *)
    echo "Usage: run normal|bedrock" >&2
    exit 1
    ;;
  esac
}

run_container "$1"
